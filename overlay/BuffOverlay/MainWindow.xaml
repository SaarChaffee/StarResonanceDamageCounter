<Window x:Class="BuffOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuffOverlay"
        SizeToContent="WidthAndHeight"
        MinWidth="120"
        MinHeight="30"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <!-- Buff tag style -->
        <Style x:Key="BuffTag" TargetType="Border">
            <Setter Property="Background" Value="#CC2a2a3e"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Border Background="#AA1a1a2e" CornerRadius="6" Padding="6,4">
        <Grid>
            <!-- Status indicator (tiny dot, top-right corner) -->
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="Gray"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>

            <!-- Buff list: vertical stack -->
            <ItemsControl x:Name="BuffList" Margin="0,2,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BuffTag}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayId}" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center" FontWeight="Medium"/>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{Binding TimeColor}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding LayerText}" Foreground="#FFA500" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                                           Visibility="{Binding LayerVisibility}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText" Text="--"
                       Foreground="#555555" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
